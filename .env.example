# Copy this file to .env

# Admin Configuration (IMPORTANT: Change these!)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changeme"

# Features
ALLOW_REGISTRATION="false"
ENABLE_BALANCE_HISTORY="true"
TRUST_PROXY="true"
ALLOW_UNVERIFIED_REGISTRATION="false"

# Public URL used to create password-reset and email-verification links
APP_URL="https://finance.example.com"

# Brevo SMTP (create an SMTP key in Brevo; do not use an API key)
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_SECURE="false"
BREVO_SMTP_USER="your-brevo-smtp-login"
BREVO_SMTP_KEY="your-brevo-smtp-key"
EMAIL_FROM="My Finance Tracker <finance@example.com>"

# Production Settings
NODE_ENV="production"
