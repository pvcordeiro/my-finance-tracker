# Copy this file to .env

# Optional host port (defaults to 4242; not the app's internal port)
HOST_PORT="4242"

# Admin Configuration (IMPORTANT: Change these!)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changeme"

# Features
ALLOW_REGISTRATION="false"
ENABLE_BALANCE_HISTORY="true"
TRUST_PROXY="true"
ALLOW_UNVERIFIED_REGISTRATION="false"
ENABLE_SMTP="true"

# Required for email verification and password-reset links when ENABLE_SMTP=true
APP_URL="https://finance.example.com"

# SMTP provider settings (see SMTP_SETUP.md)
# Set ENABLE_SMTP="false" above to disable all email features and omit SMTP credentials.
SMTP_HOST="your-provider-smtp-host"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password-or-key"
EMAIL_FROM=verified-sender@your-domain.com
EMAIL_FROM_NAME="My Finance Tracker"
